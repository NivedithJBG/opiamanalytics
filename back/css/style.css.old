.navbar-toggler-icon span {
    position: absolute;
    top: 50%;
    left: 10px;
    right: 10px;
    display: block;
    height: 4px;
    margin-top: -2px;
    background-color: #fff;
    font-size: 0px;
    -webkit-touch-callout: none;
    -webkit-user-select: none;
    -khtml-user-select: none;
    -moz-user-select: none;
    -ms-user-select: none;
    user-select: none;
    -webkit-transition: background-color 0.2s;
    transition: background-color 0.2s;
}
.navbar-toggler-icon span:before, .navbar-toggler-icon span:after {
    position: absolute;
    left: 0;
    width: 100%;
    height: 100%;
    background: #fff;
    content: '';
    -webkit-transition: -webkit-transform 0.3s;
    transition: transform 0.3s;
}
.navbar-toggler-icon span:before {
    -webkit-transform: translateY(-220%);
    transform: translateY(-220%);
}
.navbar-toggler-icon span:after {
    -webkit-transform: translateY(220%);
    transform: translateY(220%);
}
.navbar-toggler{
	position:relative;
	
	border:none;
}
.navbar-toggler-icon {
	background:none !important;
}
.navbar-toggler[aria-expanded='true'] .navbar-toggler-icon span:before {
    -webkit-transform: translateY(0) rotate(45deg);
    transform: translateY(0) rotate(45deg);
}
.navbar-toggler[aria-expanded='true'] .navbar-toggler-icon span:after {
    -webkit-transform: translateY(0) rotate(-45deg);
    transform: translateY(0) rotate(-45deg);
}
.navbar-toggler[aria-expanded='true'] .navbar-toggler-icon span {
    background: transparent;
}
.desktoponly{
	display:block;
}
.phoneonly{
	display:none;
}






