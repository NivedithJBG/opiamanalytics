.anim-dotted-line path {
  stroke-dasharray: 1000;
  stroke-dashoffset: 1000;
  animation: dash 20s linear alternate infinite;
   stroke-dasharray: 6;
   fill:none;
   stroke: #ffffff;
}


@keyframes dash {
  from {
    stroke-dashoffset: 1000;
  }
  to {
    stroke-dashoffset: 0;
  }
}


