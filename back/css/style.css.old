}
.anim-line-wrpr {
    background: #b9d6fe;
    border-radius: 2px;
}
.anim-line-one {
    width: 10px;
    height: 10px;
    background: #4aafff;
    border-radius: 2px;
	animation-name: lineOne;
	animation-duration: 4s;
	animation-fill-mode: forwards;
}


@keyframes lineOne {
  from {width:10px;}
  to {width:230px;}
}
.anim-line-two {
    width: 10px;
    height: 10px;
    background: #1a598c;
    border-radius: 2px;
	margin-top:6px;
	animation-name: lineTwo;
	animation-duration: 4s;
	animation-delay:1s;
	animation-fill-mode: forwards;
}
@keyframes lineTwo {
  from {width:10px;}
  to {width:130px;}
}
.anim-line-wrpr {
    background: #b9d6fe;
    border-radius: 7px;
}
.anim-line-one_2 {
    width: 10px;
    height: 10px;
    background: #4aafff;
    border-radius: 7px;
	animation-name: lineOne_2;
	animation-duration: 4s;
	animation-fill-mode: forwards;
}

@keyframes lineOne_2 {
  from {width:10px;}
  to {width:30px;}
}

.anim-line-two_2 {
    width: 10px;
    height: 10px;
    background: #4aafff;
    border-radius: 7px;
	animation-name: lineTwo_2;
	animation-duration: 4s;
	animation-fill-mode: forwards;
}

@keyframes lineTwo_2 {
  from {width:10px;}
  to {width:50px;}
}
.anim-line-three_2 {
    width: 10px;
    height: 10px;
    background: #4aafff;
    border-radius: 7px;
	animation-name: lineThree_2;
	animation-duration: 4s;
	animation-fill-mode: forwards;
}

@keyframes lineThree_2 {
  from {width:10px;}
  to {width:40px;}
}
.hline-chart-box1 {
    display: flex;
    flex-direction: column;
    justify-content: space-evenly;
    height: 51px
}


.hline-chart-box {
    padding: 20px 8px;
}
.anim-vline-wrpr {
    background: #e0e0e0;
    width: 9px;
    height: 59px;
    border-radius: 2px;
	display: flex;
    align-items: flex-end;
}
.vline-chart-box {
    padding: 10px;
    padding-top: 0;
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
	
}
.anim-vline-one,
.anim-vline-two,
.anim-vline-three,
.anim-vline-four,
.anim-vline-five{
	
	width: 9px;
	height: 0px;
	background:#ff6559;
	animation-name: vlineOne;
	animation-duration: 3s;
	animation-fill-mode: forwards;
}
.anim-vline-two{
	animation-name: vlineTwo;
}
.anim-vline-three{
	animation-name: vlineThree;
}
.anim-vline-four{
	animation-name: vlineFour;
}
.anim-vline-five{
	animation-name: vlineFive;
}
@keyframes vlineOne {
  from {height: 0px;}
  to {height: 59px;}
}
@keyframes vlineTwo {
  from {height: 0px;}
  to {height: 49px;}
}
@keyframes vlineThree {
  from {height: 0px;}
  to {height: 39px;}
}
@keyframes vlineFour {
  from {height: 0px;}
  to {height: 20px;}
}
@keyframes vlineFive {
  from {height: 0px;}
  to {height: 25px;}
}
.piechart-box circle,
.piechart-box2 circle  {
  fill: #4aafff;
  stroke: #0074d9;
  stroke-width: 50;
  stroke-dasharray: 0 158;
  transition: stroke-dasharray 3s ease;
}

.piechart-box svg,
.piechart-box2 svg {
  margin: 0 auto;
  transform: rotate(-90deg);
  background: #4aafff;
  border-radius: 50%;
  display: block;
}

