$(document).on( "click", ".viewestimate", function(){
    $('.estimate').hide();
    $('.estimateworkgroup').hide();
    //$('.acc_container').slideUp();
    $('#project').removeClass('active').next().slideUp(); //Remove all .acc_trigger classes and slide up the immediate next container
    //$(this).toggleClass('active').next().slideDown();
    $('#Estimate').addClass('active').next('.acc_container').slideDown();
    var id= $(this).val();
    $('#proddispprojectname').html(getProjectname(id));
    $('#selectedProjectId').val(id);

});
$(document).on( "click", "#Estimate", function(){
    if($('#selectedProjectId').val()!=''){
        //$('.acc_container').slideUp();
        $('.acc_trigger').removeClass('active').next().slideUp(); //Remove all .acc_trigger classes and slide up the immediate next container
        //$(this).toggleClass('active').next().slideDown();
        $('.estimate').hide();
        $('.estimateworkgroup').hide();
        $('#Estimate').addClass('active').next('.acc_container').slideDown();
        $('#proddispprojectname').html(getProjectname($('#selectedProjectId').val()));
        $('#selectedProjectId').val($('#selectedProjectId').val());

    }
});
$(function () {
    $('[data-toggle="tooltip"]').tooltip()
})
$(function(){

$('#estimatelistproduct').click(function(){
    //$('#productaddsection').slideUp('slow');// slide down the project listing div
    $('.estimate').hide();
    $('.estimateworkgroup').hide();
    $('#estimateproductlistsection').slideDown('slow');// slide down the project listing div
    //$('#listproduct').removeClass('btn-danger').addClass('btn-success');
    //$('#addproduct').removeClass('btn-success').addClass('btn-danger');
    $.ajax({
        type: 'POST',
        url: '../products/estimateproducts',
        beforeSend : function(){
            $('.preloader').show();
        },
        dataType: "json",
        data: {productname:$('#searchproductname').val(),projectid:$('#selectedProjectId').val()},
        success: function(data){
            if(data.error=='No')
            {
                $('#estimateproductitems').html(data.result);
                $('#estimateproducttable').show();
            }
            else
            {
                alert(data.errortext);
            }
            $('.preloader').hide();
        }
    });
});
