    $(document).on('change','#costingworkgroups',function(){
        $.ajax({
            type: 'POST',
            url: '../projects/costingiows',
            beforeSend : function(){
                $('.preloader').show();
            },
            dataType: "json",
            data: {workgroupid:$(this).val()},
            success: function(data){
                if(data.error=='No')
                {
                    $('#estimateiowlist').html(data.result);
                }
                else
                {
                    alert(data.errortext);
                }
                $('.preloader').hide();
            }
        });
    });
    $(document).ready(function(){
        $('#costingworkgroups').change(function(){
            $.ajax({
                type: 'POST',
                url: '../projects/costingiows',
                beforeSend : function(){
                    $('.preloader').show();
                },
                dataType: "json",
                data: {workgroupid:$(this).val()},
                success: function(data){
                    if(data.error=='No')
                    {
                        $('#estimateiowlist').html(data.result);
                    }
                    else
                    {
                        alert(data.errortext);
                    }
                    $('.preloader').hide();
                }
            });
        })

    });

});
$(function(){
    // function to search resources
    $('#resourcesearch').click(function(){
        var toshow=$('#selecttype').val();
        var searchval=$('#searchname').val();
        $.ajax({
            type: 'POST',
            url: '../itemofworks/resourcesearch',
            beforeSend : function(){
                $('#resourcesearch').attr("disabled", true);
                $('.preloader').show();
            },
            dataType: "json",
            data: {resourcetype:toshow,resourcename:searchval},
            success: function(data){
                if(data.error=='No')
                {
                    $('#resourceitems').html(data.result);
                    $('#resourcetable').show();

                }
                else
                {
                    alert(data.errortext);
                }

                $('#resourcesearch').attr("disabled", false);
                $('.preloader').hide();
            }
        });
    });
});
$(document).on( "click", ".addresource", function(){
    var resid=$(this).val()
    var error=0;

    $('.error').hide();
    if(!$.isNumeric($('#resourcequantity'+resid).val()))
    {
        $('#resourcequantity'+resid).next("span").html('Enter Valid Quantity').show('slow');
        error=1;
    }
    if(error==0)
    {
        var price=$('#resourceprice'+resid).val()
        var sprice=$('#specificrate'+resid).val();
        var quantity=$('#resourcequantity'+resid).val()
        $.ajax({
            type:'POST',
            url:'../itemofworks/addresourcetemp',
            beforeSend:function(){
                $('#addresourcebutton'+resid).attr("disabled",true);
                $('.preloaderitems').show();
            },
            dataType:"json",
            data:{iow_id:$('#IowId').val(),resid:resid,rate:price,srate:sprice,quantity:quantity,action:$('#pageaction').val()},
            success:function(data){
                $('#addedresources').html(data.result);
                $('#addresourcebutton'+resid).attr("disabled",false);
                $('#resourcequantity'+resid).val('')
                $('.preloaderitems').hide();
                $('#resourcerow'+resid).remove();
                $('#iowratetotal').val(data.price);
                $('#amount').val(data.amount);
            }
        });
    }
});
$(document).on( "click", ".removeresourceitem", function(){
    var resid=$(this).val();
    $.ajax({
        type:'POST',
        url:'../itemofworks/deleteresourcetemp',
        beforeSend:function(){
            $('#removeresourceitem'+resid).attr("disabled",true);
            $('.preloaderitems').show();
        },
        dataType:"json",
        data:{resid:resid,action:$('#pageaction').val()},
        success:function(data){
            $('#addedresources').html(data.result);
            $('#iowratetotal').val(data.price);
            $('#amount').val(data.amount);
            $('#removeresourceitem'+resid).attr("disabled",false);
            $('.preloaderitems').hide();
        }
    });
});
$(document).on('click','#updateiow',function(){
    var error=0;
    $('.error').hide();
    if($('#Name').val()=='')
    {
        $('#Name').next("span").html('Enter Name').show('slow');
        error=1;
    }

    if($('#Unit').val()=='')
    {
        $('#Unit').next("span").html('Enter Unit').show('slow');
        error=1;
    }
    if(error==1)
    {
        return false;
    }
    else
    {
        return true;
    }
});
function getProjectname(id)
{
    var retval;
    $.ajax({
        type: 'POST',
        url: '../projects/Getname',
        async:false,
        data: {id:id},
        success: function(data){
            retval=data;
        }
    });
    return retval;
}

function getEstimateWorkgrouplist(id)
{
    var retval;
    $.ajax({
        type: 'POST',
        url: '../projects/GetWorkgroupsCosting',
        async:false,
        data: {id:id},
        success: function(data){
            retval=data;
        }
    });
    return retval;
}